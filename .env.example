PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Sem DATABASE_URL: SQLite local. Com DATABASE_URL: PostgreSQL + migrações automáticas.
# DATABASE_PATH=data/magias.sqlite
# Supabase: copie a URI do Session pooler (porta 5432) no painel Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_DO_SESSION_POOLER:5432/postgres
DATABASE_SSL=require
DATABASE_POOL_MAX=5
# Origens exatas, sem barra final, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,
SESSION_TTL_HOURS=192
